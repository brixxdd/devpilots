UMAMI_DB_PASSWORD=change-this-db-password
UMAMI_APP_SECRET=change-this-long-random-secret

# Set these after creating the website inside Umami.
# If you proxy Umami under the same domain, use:
# UMAMI_SCRIPT_URL=https://devpilots.duckdns.org/umami/script.js
# If you expose Umami directly on port 3006, use:
# UMAMI_SCRIPT_URL=https://devpilots.duckdns.org:3006/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
