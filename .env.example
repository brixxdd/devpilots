UMAMI_DB_PASSWORD=change-this-db-password
UMAMI_APP_SECRET=change-this-long-random-secret

# Set these after creating the website inside Umami.
# If you proxy Umami under the same domain, use:
# UMAMI_SCRIPT_URL=https://devpilots.dev/umami/script.js
# If you expose Umami directly on port 3006, use:
# UMAMI_SCRIPT_URL=https://devpilots.dev:3006/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional: only set these when you're ready to add Google Analytics / Meta
# Pixel. Both are gated by the cookie consent banner (src/components/
# CookieConsent.tsx + AnalyticsScripts.tsx) — they won't fire until the
# visitor accepts the "analytics"/"marketing" category, and won't render at
# all while these are unset. Also update next.config.ts's CSP if you add
# any other third-party script host.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
